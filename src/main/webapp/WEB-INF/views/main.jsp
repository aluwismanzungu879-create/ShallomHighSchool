<%@ page contentType="text/html;charset=UTF-8" import="java.util.*,zw.shallom.model.*,zw.shallom.service.SchoolService" %><%!
String esc(Object v){if(v==null)return "";return String.valueOf(v).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
%><% User u=(User)request.getAttribute("user");SchoolService school=(SchoolService)request.getAttribute("school");String view=(String)request.getAttribute("view");String role=u.getRole().name();String label=view.substring(0,1).toUpperCase()+view.substring(1);List<Payment> payments=(List<Payment>)request.getAttribute("payments");List<Result> results=(List<Result>)request.getAttribute("results");List<Issue> issues=(List<Issue>)request.getAttribute("issues");String ctx=request.getContextPath();String notice=(String)session.getAttribute("notice");session.removeAttribute("notice");%><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=esc(label)%> | Shallom High School</title><link rel="stylesheet" href="<%=ctx%>/assets/style.css"><script defer src="<%=ctx%>/assets/app.js"></script></head><body><div class="layout"><aside class="sidebar"><a class="brand" href="<%=ctx%>/app/dashboard"><span class="crest small">SH</span><span>SHALLOM<small>HIGH SCHOOL</small></span></a><div class="side-label"><%=esc(role)%> PORTAL</div><nav><a href="<%=ctx%>/app/dashboard">Overview</a><% if(u.getRole()==Role.STUDENT){ %><a href="<%=ctx%>/app/subjects">Subjects</a><a href="<%=ctx%>/app/sports">Sports</a><a href="<%=ctx%>/app/fees">Pay fees</a><a href="<%=ctx%>/app/results">My results</a><a href="<%=ctx%>/app/payments">Payment history</a><a href="<%=ctx%>/app/classes">Class teacher</a><a href="<%=ctx%>/app/timetable">Timetable</a><% } if(u.getRole()==Role.TEACHER){ %><a href="<%=ctx%>/app/subjects">My subjects</a><a href="<%=ctx%>/app/classes">My class</a><a href="<%=ctx%>/app/marks">Enter marks</a><a href="<%=ctx%>/app/results">Student results</a><a href="<%=ctx%>/app/timetable">Timetable</a><a href="<%=ctx%>/app/sports">Sports duties</a><% } if(u.getRole()==Role.ANCILLARY){ %><a href="<%=ctx%>/app/roster">Duty roster</a><a href="<%=ctx%>/app/issues">Report issue</a><a href="<%=ctx%>/app/notices">Notices</a><a href="<%=ctx%>/app/grounds">Grounds status</a><% } if(u.getRole()==Role.DEPUTY||u.getRole()==Role.HEADMASTER){ %><a href="<%=ctx%>/app/classes">Class teachers</a><a href="<%=ctx%>/app/subjects">Subjects</a><a href="<%=ctx%>/app/sports">Sports</a><a href="<%=ctx%>/app/results">Results</a><a href="<%=ctx%>/app/payments">Fee reports</a><a href="<%=ctx%>/app/reports">Reports</a><% } if(u.getRole()==Role.HEADMASTER){ %><a href="<%=ctx%>/app/staff">Staff</a><% } %></nav><a class="logout" href="<%=ctx%>/logout">Sign out ↗</a></aside><main class="main"><header class="topbar"><div><div class="eyebrow">SHALLOM HIGH SCHOOL</div><h1><%=esc(label)%></h1></div><div class="profile"><span class="avatar"><%=esc(u.getName().substring(0,1))%></span><span><b><%=esc(u.getName())%></b><small><%=esc(role)%></small></span></div></header><section class="content"><% if(notice!=null){ %><div class="success"><%=esc(notice)%></div><% } if(request.getAttribute("error")!=null){ %><div class="alert"><%=esc(request.getAttribute("error"))%></div><% } %>
<% if(view.equals("dashboard")){ %><div class="welcome"><div><span class="eyebrow">YOUR SCHOOL PORTAL</span><h2>Good day, <%=esc(u.getName().split(" ")[0])%></h2><p>Here is your Shallom High School overview.</p></div><span class="welcome-mark">✦</span></div><div class="cards"><% if(u.getRole()==Role.HEADMASTER||u.getRole()==Role.DEPUTY){ %><div class="card"><span>Total students</span><strong>2</strong><small>Active demo accounts</small></div><div class="card"><span>Teachers</span><strong><%=school.totalTeachers()%></strong><small>School staff</small></div><div class="card"><span>Payments</span><strong><%=school.payments().size()%></strong><small>Recorded transactions</small></div><div class="card"><span>Fees collected</span><strong>$<%=String.format("%.2f",school.totalCollected())%></strong><small>Across saved payments</small></div><% }else if(u.getRole()==Role.STUDENT){ %><div class="card"><span>My class</span><strong><%=esc(u.getClassName())%></strong><small>Current placement</small></div><div class="card"><span>Subjects</span><strong>15</strong><small>Available in syllabus</small></div><div class="card"><span>Results</span><strong><%=results.size()%></strong><small>Saved marks</small></div><div class="card"><span>Payments</span><strong><%=payments.size()%></strong><small>Your payment history</small></div><% }else{ %><div class="card"><span>Subjects</span><strong>15</strong><small>Across the school</small></div><div class="card"><span>Classes</span><strong>9</strong><small>Forms and sixth form</small></div><div class="card"><span>Results</span><strong><%=results.size()%></strong><small>Saved records</small></div><div class="card"><span>Sports</span><strong>10</strong><small>Weekly activities</small></div><% } %></div><div class="panel"><h3>Quick access</h3><p>Use the navigation to view your school information and complete your role’s tasks.</p></div><% }
else if(view.equals("subjects")){%><h2>Subjects offered</h2><p class="muted">Core and elective subjects at Shallom.</p><div class="subject-grid"><% for(String subject:(String[])request.getAttribute("subjects")){%><div class="subject"><span>✦</span><b><%=esc(subject)%></b></div><%}%></div><%}
else if(view.equals("sports")){%><h2>Sports & practice days</h2><div class="table-wrap"><table><tr><th>Sport</th><th>Practice day</th></tr><% for(String[] sport:(String[][])request.getAttribute("sports")){%><tr><td><%=esc(sport[0])%></td><td><%=esc(sport[1])%></td></tr><%}%></table></div><%}
else if(view.equals("classes")){%><h2>Class teachers</h2><div class="table-wrap"><table><tr><th>Class</th><th>Class teacher</th></tr><% for(String[] c:(String[][])request.getAttribute("classes")){%><tr><td><%=esc(c[0])%></td><td><%=esc(c[1])%></td></tr><%}%></table></div><%}
else if(view.equals("fees")){Payment receipt=(Payment)request.getAttribute("receipt");if(receipt!=null){%><div class="receipt"><div class="eyebrow">SHALLOM HIGH SCHOOL</div><h2>Payment receipt</h2><p>Knowledge · Discipline · Excellence</p><hr><p><b>Student:</b> <%=esc(receipt.getStudent())%></p><p><b>Student ID:</b> <%=esc(receipt.getStudentId())%></p><p><b>Amount:</b> $<%=String.format("%.2f",receipt.getAmount())%></p><p><b>Method:</b> <%=esc(receipt.getMethod())%></p><p><b>Date:</b> <%=esc(receipt.getTimestamp())%></p><p><b>Reference:</b> <%=esc(receipt.getReference())%></p><button class="button" onclick="window.print()">Print receipt</button></div><%}else{%><h2>Pay school fees</h2><form class="form-card" method="post" action="<%=ctx%>/app/fees"><label>Student<input value="<%=esc(u.getName())%>" readonly></label><label>Student ID<input name="studentId" value="<%=esc(u.getUsername())%>" required></label><label>Amount<input type="number" min="0.01" step="0.01" name="amount" required></label><label>Payment method<select name="method" required><option>EcoCash</option><option>Bank Transfer</option><option>Cash</option><option>Swipe</option><option>ZIPIT</option></select></label><button class="button">Submit payment</button></form><%}} 
else if(view.equals("marks")){%><h2>Enter student marks</h2><form class="form-card" method="post" action="<%=ctx%>/app/marks"><label>Student username<input name="student" required></label><label>Subject<select name="subject"><%for(String subject:(String[])request.getAttribute("subjects")){%><option><%=esc(subject)%></option><%}%></select></label><label>Mark (0–100)<input type="number" name="mark" min="0" max="100" required></label><button class="button">Save mark</button></form><%}
else if(view.equals("results")){%><h2>Student results</h2><div class="table-wrap"><table><tr><th>Student</th><th>Subject</th><th>Mark</th><th>Teacher</th></tr><%for(Result r:results){if(u.getRole()!=Role.STUDENT||r.getStudent().equals(u.getUsername())){%><tr><td><%=esc(r.getStudent())%></td><td><%=esc(r.getSubject())%></td><td><%=r.getMark()%>%</td><td><%=esc(r.getTeacher())%></td></tr><%}}%></table></div><%}
else if(view.equals("payments")||view.equals("reports")){%><h2><%=u.getRole()==Role.STUDENT?"My payment history":"All payments"%></h2><div class="table-wrap"><table><tr><th>Date</th><th>Student</th><th>Amount</th><th>Method</th><th>Reference</th></tr><%for(Payment x:payments){%><tr><td><%=esc(x.getTimestamp())%></td><td><%=esc(x.getStudent())%></td><td>$<%=String.format("%.2f",x.getAmount())%></td><td><%=esc(x.getMethod())%></td><td><%=esc(x.getReference())%></td></tr><%}%></table></div><%}
else if(view.equals("issues")){%><h2>Report an issue</h2><form class="form-card" method="post" action="<%=ctx%>/app/issues"><label>Issue details<textarea name="description" rows="5" required></textarea></label><button class="button">Submit issue</button></form><h3>Recently reported issues</h3><div class="table-wrap"><table><tr><th>Reporter</th><th>Issue</th><th>Date</th></tr><%for(Issue x:issues){%><tr><td><%=esc(x.getReporter())%></td><td><%=esc(x.getDescription())%></td><td><%=esc(x.getTimestamp())%></td></tr><%}%></table></div><%}
else if(view.equals("timetable")){%><h2>Weekly timetable</h2><div class="table-wrap"><table><tr><th>Day</th><th>08:00</th><th>10:00</th><th>12:00</th><th>14:00</th></tr><tr><td>Monday</td><td>Mathematics</td><td>English</td><td>Biology</td><td>Sports</td></tr><tr><td>Tuesday</td><td>Geography</td><td>Chemistry</td><td>Shona</td><td>Accounts</td></tr><tr><td>Wednesday</td><td>Physics</td><td>History</td><td>English</td><td>Clubs</td></tr><tr><td>Thursday</td><td>Biology</td><td>Mathematics</td><td>Commerce</td><td>Study</td></tr><tr><td>Friday</td><td>English</td><td>Agriculture</td><td>Computer Science</td><td>Assembly</td></tr></table></div><%}
else if(view.equals("roster")||view.equals("notices")||view.equals("grounds")||view.equals("staff")){%><h2><%=esc(label)%></h2><div class="panel"><p><%if(view.equals("roster")){%>Monday: Main block · Tuesday: Dining hall · Wednesday: Grounds inspection · Thursday: Library · Friday: Assembly hall<%}else if(view.equals("notices")){%>School notices: Term activities and weekly duty updates are posted here by the administration.<%}else if(view.equals("grounds")){%>Grounds status: Field open. Report maintenance issues using the Report issue form.<%}else{%>Teaching staff: <%=school.totalTeachers()%> · Ancillary staff: 2 · Deputy headmaster: 1<%}%></p></div><%}else{%><h2><%=esc(label)%></h2><div class="panel">School overview · <a href="<%=ctx%>/app/subjects">Subjects</a> · <a href="<%=ctx%>/app/classes">Class teachers</a> · <a href="<%=ctx%>/app/results">Results</a></div><%}%></section></main></div></body></html>
